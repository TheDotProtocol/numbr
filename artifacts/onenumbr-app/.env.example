# ---------------------------------------------------------------------------
# OneNumbr Platform — Firebase configuration
#
# This file is a TEMPLATE. Copy it to `.env.local` and fill in real values.
# NEVER commit .env.local or any service account key.
# ---------------------------------------------------------------------------

# ---- Client-side Firebase (safe to expose; protected by security rules) ----
# Find these in: Firebase console → Project settings → General
# → "Your apps" → Web app → SDK setup and configuration (Config mode).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<project-id>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=<project-id>.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Server-side only (NEVER prefix with NEXT_PUBLIC_) ----
# Used by the admin API routes and scripts (via firebase-admin).
# Paste the FULL JSON of the service account key on one line, or set
# GOOGLE_APPLICATION_CREDENTIALS to point at a downloaded key file instead.
# Get it from: Firebase console → Project settings → Service accounts
# → Generate new private key.
FIREBASE_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# ---- Server bootstrap / development convenience ----
# Comma-separated emails granted admin claims when running `pnpm set-admin`.
ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# First real provider — cloud communications (Prompt 17)
#
# ALL of these stay EMPTY/unset until a real vendor is selected and its
# credentials are issued. Values are never committed anywhere. Without a
# complete configuration the adapter is inert and the mock provider remains
# the operational communications provider.
# ---------------------------------------------------------------------------
# Registry id of the configured vendor (set only when a vendor is chosen).
CLOUD_COMMS_PROVIDER_ID=
# Vendor API key / account identifier (SECRET — server-only).
CLOUD_COMMS_API_KEY=
# Vendor API secret / auth token (SECRET — server-only).
CLOUD_COMMS_API_SECRET=
# Webhook signature verification secret (SECRET — server-only).
CLOUD_COMMS_WEBHOOK_SECRET=
# Comma-separated VERIFIED capabilities for this vendor, e.g. "sms,voice".
# Only capabilities the vendor actually provides may be listed — never infer.
CLOUD_COMMS_CAPABILITIES=
# true = sandbox/test mode; live paid operations stay blocked.
CLOUD_COMMS_SANDBOX_MODE=
# Feature flag: master switch for the real provider (default OFF).
FEATURE_CLOUD_COMMUNICATIONS_PROVIDER_ENABLED=
